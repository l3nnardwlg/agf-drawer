# AGF Drawer — Environment Configuration Example

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database (PostgreSQL 17+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agf_drawer?schema=public"

# Security Secrets (Must be at least 32 characters in production)
SESSION_SECRET="replace-with-a-cryptographically-secure-secret-32-chars"
CSRF_SECRET="replace-with-a-cryptographically-secure-csrf-secret-32"
COOKIE_SECRET="replace-with-a-cryptographically-secure-cookie-secret-32"

# CORS (Comma-separated allowed origins, no wildcards when using credentials)
CORS_ORIGIN="http://localhost:3000"

# Session Expiration (in seconds, default 7 days)
SESSION_TTL_SECONDS=604800

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Optional SMTP for Verification & Password Reset
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AGF Drawer <noreply@agf-studios.com>"
